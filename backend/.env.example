# 复制成 .env 再填真实值：  cp .env.example .env
# 密码里的特殊字符要做 URL 编码：@ -> %40，# -> %23，/ -> %2F
DB_URL=mysql+aiomysql://root:your_password@localhost:3306/your_db?charset=utf8

# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEBUG=true
